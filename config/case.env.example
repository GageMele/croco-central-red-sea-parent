#!/bin/bash
# Copy to case.env.local. Never commit the local copy.

# ============================== EDIT HERE ==============================
export CROCO_ROOT=/ibex/user/meleg/CROCO_SETUP
export CRS_CASE=CENTRAL_RED_SEA_PARENT_GEBCO
export CRS_YEAR=2024
export CRS_MONTH=1

# Exact installed preprocessing configuration files.
export CRS_GRID_CONFIG=$CROCO_ROOT/CONFIGS/$CRS_CASE/CONFIG/grid_CRS.ini

# Source bathymetry file downloaded from GEBCO.
export CRS_GEBCO_FILE=$CROCO_ROOT/DATA/BATHYMETRY/GEBCO_2026_CRS.nc

# Forcing subset in installed CROCO_PYTOOLS order: [north, west, south, east].
# Keep padding beyond the actual model grid.
export CRS_FORCE_NORTH=25.0
export CRS_FORCE_WEST=34.5
export CRS_FORCE_SOUTH=20.5
export CRS_FORCE_EAST=39.75

# Confirm the current Copernicus product with the installed downloader/catalogue.
export CRS_GLORYS_DATASET=cmems_mod_glo_phy_my_0.083deg_P1M-m

# COPY FROM VALIDATED JANUARY CASE. The script refuses blank values.
export CRS_THETA_S=
export CRS_THETA_B=
export CRS_N=
export CRS_HC=
export CRS_OBC_SOUTH=
export CRS_OBC_NORTH=
export CRS_OBC_WEST=
export CRS_OBC_EAST=
# =========================== END EDIT HERE =============================

export CRS_DIR=$CROCO_ROOT/CONFIGS/$CRS_CASE
export CRS_GRID=$CRS_DIR/CROCO_FILES/croco_grd.nc
export PREPRO=$CROCO_ROOT/croco_pytools/prepro
export PYENV=$CROCO_ROOT/ENVS/croco_pyenv
export CRS_GLORYS_DIR=$CROCO_ROOT/DATA/CENTRAL_RED_SEA_GLORYS
export CRS_ERA5_DIR=$CROCO_ROOT/DATA/CENTRAL_RED_SEA_ERA5
